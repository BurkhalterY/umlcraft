<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.burkhaltery.UMLCraft</id>
  <name>UMLCraft</name>
  <summary>Draw UML class and use case diagrams</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <description>
    <p>UMLCraft is a UML modeler for class and use case diagrams. It opens and saves .mdj model files,
    keeping everything it does not edit exactly as it was.</p>
  </description>
  <launchable type="desktop-id">io.github.burkhaltery.UMLCraft.desktop</launchable>
  <url type="homepage">https://github.com/BurkhalterY/umlcraft</url>
  <provides><binary>umlcraft</binary></provides>
  <releases><release version="@VERSION@" date="@DATE@"/></releases>
  <content_rating type="oars-1.1"/>
</component>
